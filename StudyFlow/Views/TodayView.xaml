<UserControl x:Class="StudyFlow.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Today"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="32,28,32,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,0,32,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sledeći zadatak -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SLEDEĆI ZADATAK"
                                       Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Text="Ponoviti B-stabla"
                                       Style="{StaticResource TaskTitleStyle}"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="Prvi korak: otvoriti beleške sa predavanja i pročitati definiciju."
                                       Style="{StaticResource SecondaryTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="Procena: 25 min"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       FontSize="13"
                                       Margin="0,10,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Pokreni fokus"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center"
                                Margin="24,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Najvažnije za danas -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        MinHeight="300"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Najvažnije za danas"
                                   Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="Ponoviti B-stabla"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,12,0,0"/>
                        <TextBlock Text="Završiti vežbu iz SQL-a"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Ostali zadaci -->
                <Border Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        MinHeight="300"
                        Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Ostali zadaci za danas"
                                   Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="Pregledati beleške iz OOP-a"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,12,0,0"/>
                        <TextBlock Text="Poslati email profesoru"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>