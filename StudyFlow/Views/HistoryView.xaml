<UserControl x:Class="StudyFlow.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="History"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="32,28,32,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,0,32,32">

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="UKUPNO FOKUSIRANO"
                                   Style="{StaticResource SectionLabelStyle}"/>
                        <TextBlock Text="95 min"
                                   Style="{StaticResource TaskTitleStyle}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" MinHeight="260">
                    <StackPanel>
                        <TextBlock Text="Nedavne sesije"
                                   Style="{StaticResource CardTitleStyle}"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Danas"
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="Ponoviti B-stabla"
                                       Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Grid.Column="2" Text="25 min"
                                       Style="{StaticResource BodyTextStyle}"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Juče"
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="Vežba iz SQL-a"
                                       Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Grid.Column="2" Text="45 min"
                                       Style="{StaticResource BodyTextStyle}"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Juče"
                                       Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="Bez zadatka"
                                       Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Grid.Column="2" Text="25 min"
                                       Style="{StaticResource BodyTextStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>