<UserControl x:Class="StudyFlow.Views.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Inbox"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="32,28,32,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,0,32,32">

                <!-- Brz unos -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 FontSize="14"
                                 Padding="10"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Dodaj"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="12,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Nezakazani zadaci -->
                <Border Style="{StaticResource CardStyle}" MinHeight="260">
                    <StackPanel>
                        <TextBlock Text="Nezakazano"
                                   Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="Pogledati vodič za EF Core"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,12,0,0"/>
                        <TextBlock Text="Prijaviti ispit iz verovatnoće"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,8,0,0"/>
                        <TextBlock Text="Ideja: napraviti beleške o Kotlin-u"
                                   Style="{StaticResource BodyTextStyle}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>