<Window x:Class="StudyFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Study Flow"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Leva navigacija -->
        <Border Grid.Column="0" Background="#1F2933">
            <StackPanel Margin="16,24,16,16">
                <TextBlock Text="StudyFlow"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="8,0,0,24"/>

                <Border Background="#0F9D8F" CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                    <TextBlock Text="Today" Foreground="White" FontSize="14"/>
                </Border>

                <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                    <TextBlock Text="Inbox" Foreground="#D1D5DB" FontSize="14"/>
                </Border>

                <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                    <TextBlock Text="Areas" Foreground="#D1D5DB" FontSize="14"/>
                </Border>

                <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                    <TextBlock Text="History" Foreground="#D1D5DB" FontSize="14"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Glavna površina -->
        <Grid Grid.Column="1" Background="#F3F4F6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Today"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Margin="32,28,32,16"/>

            <!-- Sadržaj Today ekrana -->
            <Grid Grid.Row="1" Margin="32,0,32,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sledeći zadatak (preko obe kolone) -->
                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
            Background="White"
            CornerRadius="8"
            Padding="24"
            Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SLEDEĆI ZADATAK"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#0F9D8F"/>
                            <TextBlock Text="Ponoviti B-stabla"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           Margin="0,6,0,0"/>
                            <TextBlock Text="Prvi korak: otvoriti beleške sa predavanja i pročitati definiciju."
                           FontSize="14"
                           Foreground="#6B7280"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
                            <TextBlock Text="Procena: 25 min"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0,10,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                    Content="Pokreni fokus"
                    VerticalAlignment="Center"
                    Margin="24,0,0,0"
                    Padding="20,10"
                    FontSize="14"
                    Background="#0F9D8F"
                    Foreground="White"
                    BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- Najvažnije za danas -->
                <Border Grid.Row="1" Grid.Column="0"
            Background="White"
            CornerRadius="8"
            Padding="24"
            Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Najvažnije za danas"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#111827"/>
                        <TextBlock Text="Ponoviti B-stabla"
                       FontSize="14" Foreground="#374151" Margin="0,12,0,0"/>
                        <TextBlock Text="Završiti vežbu iz SQL-a"
                       FontSize="14" Foreground="#374151" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Ostali zadaci -->
                <Border Grid.Row="1" Grid.Column="1"
            Background="White"
            CornerRadius="8"
            Padding="24"
            Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Ostali zadaci za danas"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#111827"/>
                        <TextBlock Text="Pregledati beleške iz OOP-a"
                       FontSize="14" Foreground="#374151" Margin="0,12,0,0"/>
                        <TextBlock Text="Poslati email profesoru"
                       FontSize="14" Foreground="#374151" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>