<Window x:Class="StudyFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Study Flow"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Leva navigacija -->
        <Border Grid.Column="0" Background="#1F2933">
            <StackPanel Margin="16,24,16,16">
                <TextBlock Text="StudyFlow"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="8,0,0,24"/>

                <Border Background="#0F9D8F" CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                    <TextBlock Text="Today" Foreground="White" FontSize="14"/>
                </Border>

                <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                    <TextBlock Text="Inbox" Foreground="#D1D5DB" FontSize="14"/>
                </Border>

                <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                    <TextBlock Text="Areas" Foreground="#D1D5DB" FontSize="14"/>
                </Border>

                <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,4">
                    <TextBlock Text="History" Foreground="#D1D5DB" FontSize="14"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Glavna površina -->
        <Grid Grid.Column="1" Background="#F3F4F6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Today"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#111827"
                       Margin="32,28,32,16"/>

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="24"
                    Margin="32,0,32,32">
                <TextBlock Text="Ovde ide sadržaj ekrana."
                           Foreground="#6B7280"
                           FontSize="14"/>
            </Border>
        </Grid>
    </Grid>
</Window>