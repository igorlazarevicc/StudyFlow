<Window x:Class="StudyFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StudyFlow.Views"
        Title="StudyFlow"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Leva navigacija -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <StackPanel Margin="16,24,16,16">
                <TextBlock Text="StudyFlow"
                           Foreground="{StaticResource TextOnDarkBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="8,0,0,24"/>

                <RadioButton x:Name="TodayNav" Content="Today" GroupName="Navigation" IsChecked="True"
                             Style="{StaticResource NavItemStyle}"/>
                <RadioButton x:Name="InboxNav" Content="Inbox" GroupName="Navigation"
                             Style="{StaticResource NavItemStyle}"/>
                <RadioButton x:Name="AreasNav" Content="Areas" GroupName="Navigation"
                             Style="{StaticResource NavItemStyle}"/>
                <RadioButton x:Name="HistoryNav" Content="History" GroupName="Navigation"
                             Style="{StaticResource NavItemStyle}"/>
            </StackPanel>
        </Border>

        <!-- Glavna površina: privremeno prebacivanje ekrana -->
        <Grid Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
            <views:TodayView
                Visibility="{Binding IsChecked, ElementName=TodayNav, Converter={StaticResource BoolToVisibility}}"/>
            <views:InboxView
                Visibility="{Binding IsChecked, ElementName=InboxNav, Converter={StaticResource BoolToVisibility}}"/>
            <views:AreasView
                Visibility="{Binding IsChecked, ElementName=AreasNav, Converter={StaticResource BoolToVisibility}}"/>
            <views:HistoryView
                Visibility="{Binding IsChecked, ElementName=HistoryNav, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</Window>