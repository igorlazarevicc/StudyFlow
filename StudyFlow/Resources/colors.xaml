<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Pozadine -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1F2933"/>

    <!-- Akcent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0F9D8F"/>

    <!-- Tekst -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
    <SolidColorBrush x:Key="TextBodyBrush" Color="#374151"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#D1D5DB"/>

</ResourceDictionary>